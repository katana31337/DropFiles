# Server
PORT=3001
NODE_ENV=development

# Frontend URL (для CORS)
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=filedrop
DB_USER=postgres
DB_PASSWORD=postgres

# Storage: 'local' или 's3'
STORAGE_TYPE=local
DATASTORE_PATH=./datastore

# S3 (если STORAGE_TYPE=s3)
# S3_BUCKET=filedrop
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key

# Admin Panel
# Секретный URL админки — придумайте свой уникальный путь!
ADMIN_SECRET_PATH=/my-secret-admin-xyz789

# JWT Secret для токенов админа (ОБЯЗАТЕЛЬНО измените в продакшене!)
JWT_SECRET=change-this-to-a-random-secret-string-at-least-32-chars
